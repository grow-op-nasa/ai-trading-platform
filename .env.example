# Copy to .env (scripts/setup_app.sh does this if .env is missing) and edit. .env is git-ignored; never commit it.
# The launcher loads .env for the app only. For CLI use in a terminal run:  set -a; source .env; set +a
# Existing environment variables always win over values in this file.

# Optional. Only the explicit AI-agent CLI commands use it; the app, monitoring and paper cycles do not.
# ANTHROPIC_API_KEY=

# Alert delivery (off unless ATP_ALERTS_ENABLED=true). Delivery is verified only by `alerts test-send`.
# ATP_ALERTS_ENABLED=true
# ATP_ALERT_TRANSPORT=smtp
# ATP_ALERT_SMTP_HOST=smtp.example.com
# ATP_ALERT_SMTP_PORT=587
# ATP_ALERT_SMTP_SECURITY=starttls
# ATP_ALERT_SMTP_USERNAME=
# ATP_ALERT_SMTP_PASSWORD=
# ATP_ALERT_FROM=atp@example.com
# ATP_ALERT_TO=you@example.com
# ATP_ALERT_EXISTING_FINDINGS=baseline
